generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model abandoned_carts {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String?   @db.Uuid
  email      String?   @db.Citext
  cart       Json
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model addresses {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?  @db.Uuid
  recipient   String
  phone       String
  line1       String
  city_id     String
  postal_code String
  lat         Decimal? @db.Decimal
  lng         Decimal? @db.Decimal
  users       users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model admins {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String       @unique @db.Citext
  password_hash String
  role          admin_role
  totp_secret   String
  audit_logs    audit_logs[]
}

model audit_logs {
  id        BigInt   @id @default(autoincrement())
  admin_id  String?  @db.Uuid
  action    String
  entity    String
  entity_id String?
  diff      Json?
  ip        String?  @db.Inet
  at        DateTime @default(now()) @db.Timestamptz(6)
  admins    admins?  @relation(fields: [admin_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model categories {
  id               Int          @id @default(autoincrement())
  parent_id        Int?
  slug             String       @unique
  name             String
  level            Int          @db.SmallInt
  sort_order       Int          @default(0)
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]
}

model coupons {
  code        String    @id
  kind        String
  value       Decimal   @db.Decimal
  starts_at   DateTime? @db.Timestamptz(6)
  ends_at     DateTime? @db.Timestamptz(6)
  usage_limit Int?
  used        Int?      @default(0)
}

model info_pages {
  slug      String @id
  title     String
  body_html String
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  order_id         String           @db.Uuid
  variant_id       String           @db.Uuid
  qty              Int
  unit_price       Decimal          @db.Decimal(12, 2)
  unit_cost        Decimal          @db.Decimal(12, 2)
  orders           orders           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([order_id, variant_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String?           @db.Uuid
  guest_email         String?           @db.Citext
  status              order_status      @default(pending)
  checkout_state      checkout_state    @default(cart_verified)
  subtotal            Decimal           @db.Decimal(12, 2)
  shipping_cost       Decimal           @default(0) @db.Decimal(12, 2)
  discount            Decimal           @default(0) @db.Decimal(12, 2)
  total               Decimal           @db.Decimal(12, 2)
  shipping_address    Json?
  courier             String?
  tracking_number     String?
  payment_ref         String?
  paid_at             DateTime?         @db.Timestamptz(6)
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  tracking_state      tracking_state    @default(ORDERED)
  last_raw_status     String?
  tracking_updated_at DateTime?         @default(now()) @db.Timestamptz(6)
  order_items         order_items[]
  users               users?            @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tracking_events     tracking_events[]
}

model payment_events {
  id          BigInt   @id @default(autoincrement())
  provider    String
  event_id    String
  payload     Json
  received_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([provider, event_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_variants {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id          String        @db.Uuid
  sku                 String        @unique
  size                String?
  color               String?
  variant             String?
  price_override      Decimal?      @db.Decimal(12, 2)
  stock               Int           @default(0)
  low_stock_threshold Int           @default(5)
  order_items         order_items[]
  products            products      @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model products {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id      Int
  name             String
  slug             String             @unique
  description_html String?
  base_price       Decimal            @db.Decimal(12, 2)
  cost_price       Decimal            @default(0) @db.Decimal(12, 2)
  weight_grams     Int
  tags             String[]           @default([])
  is_active        Boolean            @default(true)
  product_variants product_variants[]
  categories       categories         @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wholesale_tiers  wholesale_tiers[]
}

model site_settings {
  key   String @id
  value Json
}

model tracking_events {
  id              BigInt         @id @default(autoincrement())
  order_id        String         @db.Uuid
  tracking_number String?
  carrier         String?
  raw_status      String
  mapped_state    tracking_state
  location        String?
  event_time      DateTime       @default(now()) @db.Timestamptz(6)
  raw_payload     Json?
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  orders          orders         @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_tracking_events_order_id")
}

model users {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String           @unique @db.Citext
  password_hash  String
  full_name      String
  phone          String?
  segment        customer_segment @default(retail)
  loyalty_points Int              @default(0)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  addresses      addresses[]
  orders         orders[]
}

model wholesale_tiers {
  product_id String   @db.Uuid
  min_qty    Int
  unit_price Decimal  @db.Decimal(12, 2)
  products   products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([product_id, min_qty])
}

enum admin_role {
  super_admin
  chat_admin
  warehouse_admin
}

enum checkout_state {
  cart_verified
  address_validated
  payment_pending
  paid
  failed
}

enum customer_segment {
  retail
  wholesale
  reseller
  loyal
}

enum order_status {
  pending
  processing
  shipped
  completed
  cancelled
}

enum tracking_state {
  ORDERED
  SHIPPED
  IN_CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
}

model Product {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  description  String?
  basePrice    Float
  category     String?
  department   String?        @default("Men") // Men, Women, Accessories
  subcategory  String?        // Tops, Bottoms, Outerwear, Bags, etc.
  itemType     String?        // Polo Shirt, T-Shirt, Hoodie, etc.
  tags         String?        // Comma-separated search tags
  isTrending   Boolean        @default(false)
  isNewRelease Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  images       ProductImage[]
  variants     Variant[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  colorTag  String   // Images strictly grouped by COLOR tag
  createdAt DateTime @default(now())

  @@index([productId, colorTag])
}

model Variant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String
  size      String
  sku       String   @unique
  price     Float
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([color, size])
}

model product_reviews {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id        String   @db.VarChar(255)
  user_email        String   @db.Citext
  user_name         String   @db.VarChar(255)
  rating            Int      @db.SmallInt
  title             String?  @db.VarChar(255)
  comment           String
  is_verified_buyer Boolean  @default(false)
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@index([product_id], map: "idx_product_reviews_product_id")
  @@index([user_email], map: "idx_product_reviews_user_email")
  @@index([created_at(sort: Desc)], map: "idx_product_reviews_created_at")
}

